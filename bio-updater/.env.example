# Your Discord USER token (NOT a bot token). Per-server bio needs Nitro.
# Get it from the Discord client (Dev tools > Network > any request > authorization header),
# or set it in the mod's in-game settings instead.
DISCORD_TOKEN=

# Blank = your global (About Me) bio. Set a guild id to update one server's bio (needs Nitro).
GUILD_ID=

# Everything you want KEPT in your bio, above the runs row. Blank = auto-detect from your
# current bio. The tool only manages the runs row on the line below. Use \n for line breaks.
BASE_BIO=

# Optional tuning
PORT=8787
MAX_ENTRIES=3
MIN_SPAN=30
MIN_INTERVAL_MS=10000
